{
  "name": "rn-propy-wind",
  "version": "0.1.0",
  "description": "Tailwind-style utility props for React Native — Box, Row, Col, Text, Pressable, TouchableBox, HighlightBox, GradientButton, BlurBox, and a Reanimated-powered MotionView, all styled via props.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "tailwind",
    "styling",
    "utility-props",
    "design-system",
    "typescript"
  ],
  "author": "MujtabaBhatti09",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MujtabaBhatti09/rn-propy-wind.git"
  },
  "homepage": "https://github.com/MujtabaBhatti09/rn-propy-wind#readme",
  "bugs": {
    "url": "https://github.com/MujtabaBhatti09/rn-propy-wind/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-linear-gradient": ">=2.6.0",
    "@react-native-community/blur": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-linear-gradient": {
      "optional": true
    },
    "@react-native-community/blur": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-community/blur": "^4.4.1",
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">= 18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}